# ============================================
# 晓山青 Viridiore - 环境变量配置示例
#
# 使用说明：
# 1. 复制本文件为 .env
# 2. 填入真实的 API 密钥
# 3. .env 文件已被 .gitignore 排除，不会提交到仓库
# ============================================

# 高德地图 - Web 端密钥
# 申请地址：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=YOUR_AMAP_KEY
VITE_AMAP_SECURITY_CODE=YOUR_SECURITY_CODE

# 和风天气 API - 免费版每日 1000 次调用
# 申请地址：https://dev.qweather.com
VITE_HEWEATHER_KEY=YOUR_HEWEATHER_KEY

# WeatherAPI.com - 免费版每月 100,000 次调用
# 申请地址：https://www.weatherapi.com/signup.aspx
VITE_WEATHER_API_KEY=YOUR_WEATHER_API_KEY
